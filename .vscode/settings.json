{
  "postman.settings.dotenv-detection-notification-visibility": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/vendor": true,
    "**/build": true,
  },
  "search.exclude": {
    "**/build/**": true,
    "**/wp-content/uploads/**": true,
    "**/wp-content/cache/**": true,
    "**/node_modules/**": true,
    "**/vendor/**": true,
    "**/plugins/**": true,
  },
  "files.watcherExclude": {
    "**/wp-content/uploads/**": true,
    "**/wp-content/cache/**": true,
    "**/node_modules/**": true,
    "**/vendor/**": true
  }
}
